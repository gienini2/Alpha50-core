# Copiar a la raíz como .env (el scheduler hace load_dotenv del directorio padre de alpha50/)

# Garmin Connect
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Opcionales (valores por defecto en alpha50/agente_metrica.py)
# GARMIN_TOKENSTORE=alpha50/.garmin_session
# GARMIN_MAX_RETRIES=3
# GARMIN_BACKOFF_BASE=20
# GARMIN_CACHE_MAX_DIAS=3

# Telegram vía relay (POST {RELAY_URL}/notify con cabecera X-Relay-Key)
RELAY_URL=http://<host-del-relay>:10004
RELAY_API_KEY=

# Hora del brief matutino (HH:MM, hora local)
ALPHA50_HORA=07:00
